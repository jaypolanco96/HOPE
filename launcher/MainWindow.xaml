<Window x:Class="Hope.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="HOPE — Hills, Ollies, Pavement, Expression" Icon="/Branding/hope.ico" Width="1360" Height="850"
 MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" Background="#101020"
 KeyDown="Window_KeyDown" PreviewKeyDown="Input_KeyDown" PreviewMouseDown="Input_MouseDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="24" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Image x:Name="Backdrop" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F90B0B1B" Offset="0"/><GradientStop Color="#CE111122" Offset="0.3"/><GradientStop Color="#250B0B1B" Offset="0.82"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#AA0B0B1B" Offset="0"/><GradientStop Color="#000B0B1B" Offset="0.4"/><GradientStop Color="#F70B0B1B" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Viewbox Stretch="Uniform">
   <Grid x:Name="DesignRoot" Width="1360" Height="850">
    <Border Margin="28,28,0,28" Width="244" HorizontalAlignment="Left" CornerRadius="28" Background="#F2111022" BorderBrush="#805D5278" BorderThickness="1">
     <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.55"/></Border.Effect>
     <Grid Margin="18,22">
      <Grid.RowDefinitions><RowDefinition Height="155"/><RowDefinition Height="*"/><RowDefinition Height="158"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="HOPE" Foreground="{StaticResource Pink}" FontSize="53" FontFamily="Segoe UI Black" FontStyle="Italic"/>
       <TextBlock Text="STREET SKATE / PC" Foreground="{StaticResource Mint}" FontSize="12" FontWeight="Bold" Margin="3,3,0,0"/>
       <Border Margin="0,23,0,0" Height="6" CornerRadius="3"><Border.Background><LinearGradientBrush><GradientStop Color="#FF63C8" Offset="0"/><GradientStop Color="#D6FF48" Offset="0.5"/><GradientStop Color="#75FFE1" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      </StackPanel>
      <StackPanel Grid.Row="1">
       <Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="01   Home" Tag="Home" Click="Navigate_Click"/>
       <Button x:Name="GraphicsNav" Style="{StaticResource Nav}" Content="02   Graphics" Tag="Graphics" Click="Navigate_Click"/>
       <Button x:Name="ModsNav" Style="{StaticResource Nav}" Content="03   Mods" Tag="Mods" Click="Navigate_Click"/>
       <Button x:Name="SavesNav" Style="{StaticResource Nav}" Content="04   My saves" Tag="Saves" Click="Navigate_Click"/>
       <Button x:Name="SetupNav" Style="{StaticResource Nav}" Content="05   Game setup" Tag="Setup" Click="Navigate_Click"/>
       <Button x:Name="HelpNav" Style="{StaticResource Nav}" Content="06   Help &amp; recovery" Tag="Help" Click="Navigate_Click" FontSize="15"/>
       <Button x:Name="CreditsNav" Style="{StaticResource Nav}" Content="07   Credits" Tag="Credits" Click="Navigate_Click"/>
      </StackPanel>
      <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
       <TextBlock Text="FROM THE BAY, WITH LOVE." FontSize="11" Foreground="{StaticResource Pink}" FontWeight="Bold" Margin="4,0,0,10"/>
       <TextBlock Text="An unofficial community update.&#10;Built on Skate3Recomp." FontSize="12" Foreground="#B9B6CF" Margin="4,0,0,16"/>
       <Button Content="Quit launcher" Click="Quit_Click" Padding="16,12"/>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Margin="312,38,32,36">
     <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="105"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
       <Border Background="#D918172A" BorderBrush="#8275FFE1" BorderThickness="1" CornerRadius="15" Padding="14,9">
        <TextBlock x:Name="StatusBadge" Text="●  READY TO ROLL" Foreground="{StaticResource Mint}" FontSize="12" FontWeight="Bold"/>
       </Border>
       <TextBlock Text="PHASE 4 / PERFORMANCE" Foreground="#D5CDEC" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,22"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
       <Button Content="—" Width="42" Padding="0,8" Margin="0,0,8,0" Click="Minimize_Click" AutomationProperties.Name="Minimize launcher"/>
       <Button Content="□" Width="42" Padding="0,8" Margin="0,0,8,0" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore launcher"/>
       <Button Content="×" Width="42" Padding="0,8" Margin="0" Click="Quit_Click" AutomationProperties.Name="Close launcher"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1">
      <Grid x:Name="HomePage">
       <StackPanel Margin="0,24,0,0" HorizontalAlignment="Left" Width="550">
        <Border Background="{StaticResource Pink}" CornerRadius="11" Padding="15,7" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
         <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
         <TextBlock Text="HILLS. OLLIES. PAVEMENT. EXPRESSION." Foreground="#161125" FontWeight="Black" FontSize="13"/>
        </Border>
        <TextBlock Text="HOPE" FontFamily="Segoe UI Black" FontSize="154" FontStyle="Italic" Foreground="{StaticResource Lime}" Margin="-8,6,0,-2">
         <TextBlock.Effect><DropShadowEffect Color="#FF63C8" BlurRadius="0" ShadowDepth="7" Direction="315" Opacity="1"/></TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="YOUR CITY. YOUR LINE." FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="36" Foreground="{StaticResource Mint}"/>
        <TextBlock Text="Big gaps. Street spots. One more try.&#10;Skate 3, with a fresh PC attitude." FontSize="18" Foreground="#F1EAF7" Margin="0,12,0,0" LineHeight="28"/>
       </StackPanel>
       <Border VerticalAlignment="Bottom" Background="#EE171429" BorderBrush="#8D786990" BorderThickness="1" CornerRadius="26" Padding="25,20" Margin="0,0,0,22">
        <Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.45"/></Border.Effect>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ReadyTitle" Text="Your next line is waiting." FontSize="23" FontWeight="Bold"/>
          <TextBlock x:Name="ReadyDetail" Text="Controller ready • Native graphics • Your saves" FontSize="14" Foreground="#C8BED9" Margin="0,7,10,0"/>
          <ComboBox x:Name="CareerCombo" SelectionChanged="Career_Changed" Width="410" HorizontalAlignment="Left" AutomationProperties.Name="Choose career"/>
          <TextBlock Text="In game: Start opens Skate 3's menu. Escape or RB + Start opens PC settings." Foreground="{StaticResource Mint}" FontSize="12" Margin="0,10,0,0"/>
         </StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="PlayButton" Style="{StaticResource Primary}" Content="LET’S SKATE  →" Click="Play_Click" Margin="0,0,0,8"/>
          <Button x:Name="NewCareerButton" Content="NEW CAREER" Click="NewCareer_Click" FontSize="15" Padding="12,9" Margin="0"/>
         </StackPanel>
        </Grid>
       </Border>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,340,0,0">
        <Button Content="‹" Click="PreviousPhoto_Click" Padding="14,7" Margin="0,0,6,0" AutomationProperties.Name="Previous gameplay background"/>
        <Border Background="#CF111020" CornerRadius="13" Padding="15,10" Margin="0,0,6,10"><TextBlock x:Name="PhotoCaption" Text="01 / 03   •   STREET FLIGHT" FontSize="11" Foreground="{StaticResource Lime}" FontWeight="Bold"/></Border>
        <Button Content="›" Click="NextPhoto_Click" Padding="14,7" AutomationProperties.Name="Next gameplay background"/>
       </StackPanel>
      </Grid>
      <Border x:Name="DetailsPage" Visibility="Collapsed" Background="#F3151428" BorderBrush="#97706197" BorderThickness="1" CornerRadius="28" Padding="28,22" Margin="0,8,0,22">
       <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="9" Opacity="0.5"/></Border.Effect>
       <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
         <TextBlock x:Name="PageTitle" Style="{StaticResource Title}"/>
         <TextBlock x:Name="PageIntro" TextWrapping="Wrap" Foreground="#CAC4DB" Margin="0,0,0,20" LineHeight="25"/>
         <StackPanel x:Name="GraphicsPanel" Visibility="Collapsed">
          <Button x:Name="SaveGraphicsTopButton" Content="Save graphics settings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveGraphics_Click" Margin="0,0,0,20"/>
          <Grid x:Name="GraphicsForm">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Renderer" Foreground="{StaticResource Mint}" FontWeight="Bold"/>
            <ComboBox x:Name="RendererCombo" SelectionChanged="Renderer_Changed"><ComboBoxItem Content="Native — PC graphics"/><ComboBoxItem Content="Emulated — compatibility"/></ComboBox>
            <TextBlock Text="Render resolution" Foreground="{StaticResource Mint}" FontWeight="Bold"/>
            <ComboBox x:Name="ResolutionCombo"><ComboBoxItem Content="720p (1×)"/><ComboBoxItem Content="1440p (2×)"/><ComboBoxItem Content="2160p (3×)"/></ComboBox>
            <TextBlock Text="Anti-aliasing (MSAA)" Foreground="{StaticResource Mint}" FontWeight="Bold"/>
            <ComboBox x:Name="AaCombo"><ComboBoxItem Content="Off"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/></ComboBox>
           </StackPanel>
           <StackPanel Grid.Column="2" x:Name="NativeEffects">
            <CheckBox x:Name="AoCheck" Content="Ambient occlusion"/>
            <CheckBox x:Name="AoQualityCheck" Content="Full-resolution AO"/>
            <CheckBox x:Name="FogCheck" Content="Distance fog"/>
            <CheckBox x:Name="HazeCheck" Content="Atmospheric haze"/>
            <CheckBox x:Name="ShaftsCheck" Content="Sun shafts"/>
            <CheckBox x:Name="BloomCheck" Content="Bloom"/>
           </StackPanel>
          </Grid>
          <WrapPanel Margin="0,10,0,0">
           <CheckBox x:Name="FullscreenCheck" Content="Fullscreen" Margin="0,8,25,8"/>
           <CheckBox x:Name="VsyncCheck" Content="VSync" Margin="0,8,25,8"/>
           <CheckBox x:Name="FpsCheck" Content="Show FPS in game" Margin="0,8,0,8"/>
          </WrapPanel>
          <TextBlock Text="Native effects are available with the Native renderer. Higher resolution, MSAA and AO quality use more GPU resources. Fog, haze and shafts are independent." TextWrapping="Wrap" Foreground="#C8BED9" FontSize="14" Margin="0,16,0,20"/>

          <Border CornerRadius="18" BorderBrush="#786397" BorderThickness="1" Padding="18" Margin="0,0,0,18"><StackPanel>
           <TextBlock Text="DISTANCE &amp; CAMERA" Foreground="{StaticResource Mint}" FontWeight="Bold" FontSize="21"/>
           <ItemsControl x:Name="WorldGraphicsOptions" ItemTemplate="{StaticResource GraphicsOptionTemplate}"/>
          </StackPanel></Border>
          <Border x:Name="AdvancedNativePanel" CornerRadius="18" BorderBrush="#786397" BorderThickness="1" Padding="18" Margin="0,0,0,18"><StackPanel>
           <TextBlock Text="ADVANCED NATIVE GRAPHICS" Foreground="{StaticResource Mint}" FontWeight="Bold" FontSize="21"/>
           <TextBlock Text="These controls require the Native renderer. Raise quality gradually and compare performance. Experimental options start off and still need play testing." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,12"/>
           <ItemsControl x:Name="NativeGraphicsOptions" ItemTemplate="{StaticResource GraphicsOptionTemplate}"/>
          </StackPanel></Border>
          <Border CornerRadius="18" Background="#30243F" Padding="18" Margin="0,0,0,18"><StackPanel>
           <TextBlock Text="PATH TRACING" Foreground="{StaticResource Pink}" FontWeight="Bold"/>
           <TextBlock Text="Not available in this renderer. iMMERSE Pro is an external ReShade RTGI effect; it has not been integrated or bundled with HOPE." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Button x:Name="SaveGraphicsButton" Content="Save graphics settings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveGraphics_Click"/>
         </StackPanel>
         <StackPanel x:Name="ModsPanel" Visibility="Collapsed">
          <WrapPanel><Button Content="Import mod…" Click="ImportMod_Click" Margin="0,0,12,12"/><Button x:Name="ApplyModsButton" Content="Apply selected mods" Style="{StaticResource Primary}" Click="ApplyMods_Click" Padding="20,14" FontSize="18" Margin="0,0,12,12"/><Button x:Name="DisableModsButton" Content="Disable all" Click="DisableMods_Click"/></WrapPanel>
          <TextBlock x:Name="ModsStatus" Foreground="{StaticResource Mint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ItemsControl x:Name="ModList"><ItemsControl.ItemTemplate><DataTemplate>
            <Border CornerRadius="18" Background="#30243F" BorderBrush="#786397" BorderThickness="1" Padding="18,10" Margin="0,0,0,12"><StackPanel>
             <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" Foreground="{StaticResource Lime}" FontWeight="Bold"/>
             <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#F1EAF7"/><TextBlock Text="{Binding Credit}" FontSize="12" Foreground="{StaticResource Mint}" Margin="0,8,0,0"/>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Import HOPE settings mods (.hope-mod.json). DLLs, ZIPs and replacement game files are not supported here. Disabling restores previous values and keeps later manual edits. Graphics mods require the Native renderer." TextWrapping="Wrap" FontSize="14" Foreground="#C8BED9"/>
         </StackPanel>
         <StackPanel x:Name="SavesPanel" Visibility="Collapsed">
          <ListBox x:Name="SaveList" Background="#291F3E" Foreground="#F5F1FF" BorderBrush="#786397" FontSize="18" MinHeight="130" MaxHeight="200" Padding="12" Margin="0,0,0,18"/>
          <WrapPanel><Button Content="Refresh saves" Click="RefreshSaves_Click" Margin="0,0,12,12"/><Button Content="Open save folder" Click="OpenSaves_Click" Margin="0,0,12,12"/><Button Content="Delete selected save…" Foreground="{StaticResource Pink}" Click="DeleteSave_Click"/></WrapPanel>
          <TextBlock Text="Removal keeps a recovery copy. Close the game first. Your player profile and other saves stay intact." Foreground="#C8BED9" FontSize="15" TextWrapping="Wrap"/>
          <Border x:Name="DeleteConfirm" Visibility="Collapsed" CornerRadius="18" BorderBrush="{StaticResource Pink}" BorderThickness="1" Background="#30203D" Padding="20" Margin="0,20,0,0">
           <StackPanel><TextBlock x:Name="DeleteLabel" Foreground="{StaticResource Pink}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><Button x:Name="KeepSaveButton" Content="Keep my save" Click="CancelDelete_Click" Margin="0,0,12,0"/><Button Content="Confirm removal" Foreground="{StaticResource Pink}" Click="ConfirmDelete_Click" Margin="0"/></WrapPanel></StackPanel>
          </Border>
         </StackPanel>
         <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
          <Border Background="#26392E" BorderBrush="{StaticResource Lime}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,22"><TextBlock Text="Bring your own Skate 3 Xbox 360 ISO.&#10;HOPE does not include game files or provide download links." Foreground="{StaticResource Lime}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/></Border>
          <TextBlock Text="1. Choose your own ISO" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="Use an ISO from your own Xbox 360 copy. If your game files are already installed, you can play without importing again." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,10"/>
          <Button Content="Choose my ISO…" HorizontalAlignment="Left" Click="ChooseIso_Click"/>
          <TextBlock x:Name="IsoLabel" Text="No ISO selected" Foreground="{StaticResource Mint}" TextWrapping="Wrap" Margin="0,3,0,20"/>
          <Border CornerRadius="18" Background="#30243F" Padding="18" Margin="0,0,0,18"><StackPanel>
           <TextBlock Text="ADD YOUR DLC" Foreground="{StaticResource Lime}" FontSize="21" FontWeight="Bold"/>
           <TextBlock Text="Import your own Skate 3 Xbox 360 DLC package files. Select several at once, including files without an extension. ISOs, ZIPs, saves and title updates are not DLC packages." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,12"/>
           <WrapPanel><Button x:Name="ImportDlcButton" Content="Import owned DLC…" Click="ImportDlc_Click" Margin="0,0,12,10"/><Button Content="Refresh list" Click="RefreshDlc_Click" Margin="0,0,12,10"/><Button Content="Open DLC folder" Click="OpenDlc_Click"/></WrapPanel>
           <TextBlock x:Name="DlcStatus" Foreground="{StaticResource Mint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
           <ItemsControl x:Name="DlcPackages"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
           <TextBlock Text="Shared across HOPE careers. Imported means queued: the game checks and installs packages next launch. Compatibility depends on the package and game update; check the game menus afterward. Close the game before importing. No DLC is included or linked." TextWrapping="Wrap" Foreground="#C8BED9" FontSize="14" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Border CornerRadius="18" Background="#30243F" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock Text="BETA CONTENT" Foreground="{StaticResource Pink}" FontWeight="Bold"/><TextBlock Text="No verified playable beta pack is available in this build. A beta toggle will become available when compatible content is validated." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,0"/></StackPanel></Border>
          <TextBlock Text="2. Install and start" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="HOPE opens the existing game installer to extract your ISO and finish setup. Keep the installer open until it completes." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,10"/>
          <Button Content="Install / start HOPE" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Play_Click"/>
          <WrapPanel><Button Content="Use installed game folder…" Click="ChooseGameFolder_Click" Margin="0,8,12,0"/><Button Content="Choose gameplay photo…" Click="ChoosePhoto_Click" Margin="0,8,0,0"/></WrapPanel>
         </StackPanel>
         <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
          <TextBlock Text="GET BACK TO YOUR LINE." Foreground="{StaticResource Mint}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Start opens Skate 3's menu: Restart, Trick Book, map and replay. Escape or RB + Start opens HOPE settings. Return to HOPE Launcher closes the session; it does not return to Skate 3's title screen. Finish saving first." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,12"/>
          <TextBlock x:Name="ControllerStatus" Text="Controller: waiting for an XInput device" Foreground="{StaticResource Mint}" Margin="0,0,0,8"/>
          <TextBlock Text="Check smoothness" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Press F8 in game to start a 60-second capture. Press F8 again to save it, or quit normally. Capturing is optional. The game log reports the file location if you use a custom cache folder." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,10"/>
          <Button Content="Open performance captures" Click="OpenCaptures_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          <TextBlock Text="Recover game settings" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Reset only the selected career's game settings. Its career saves, profiles, supplied game path, ISO choice and other careers stay intact. Current settings are moved to a backup. Changes apply next launch. Close the game first." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,10"/>
          <Button x:Name="ResetSettingsButton" Content="Reset game settings…" Foreground="{StaticResource Pink}" HorizontalAlignment="Left" Click="ResetSettings_Click"/>
          <TextBlock Text="Choose a backup from before the problem" Foreground="{StaticResource Mint}" Margin="0,8,0,0"/>
          <ComboBox x:Name="BackupCombo" AutomationProperties.Name="Settings backup"/>
          <TextBlock x:Name="BackupStatus" Text="No settings backups yet. Resetting settings creates one." Foreground="{StaticResource Mint}" FontSize="14" Margin="0,8,0,14" Visibility="Collapsed"/>
          <WrapPanel><Button x:Name="RestoreSettingsButton" Content="Restore selected backup" Click="RestoreSettings_Click" Margin="0,0,12,10"/><Button Content="Open career folder" Click="OpenCareer_Click"/></WrapPanel>
          <TextBlock Text="Current settings are backed up before restoration. A backup may contain the original problem; reset again or choose an earlier backup if needed. Hardware performance presets will follow measured testing." TextWrapping="Wrap" Foreground="#C8BED9" FontSize="14"/>
         </StackPanel>
         <StackPanel x:Name="CreditsPanel" Visibility="Collapsed">
          <TextBlock Text="ORIGINAL RECOMPILATION" Foreground="{StaticResource Pink}" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="mchughalex" FontSize="38" FontWeight="Black" Margin="0,8,0,12"/>
          <TextBlock Text="HOPE is a community update built on Skate3Recomp by mchughalex. The original recompilation, native renderer and foundation belong to that project and its contributors." TextWrapping="Wrap" LineHeight="27" Margin="0,0,0,24"/>
          <TextBlock Text="ReXGlue SDK &amp; Xenia contributors" Foreground="{StaticResource Mint}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Recompilation tools and Xbox 360 research behind the project." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,24"/>
          <TextBlock Text="Skate 3 — EA Black Box / Electronic Arts" Foreground="{StaticResource Mint}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Game and gameplay artwork from the player's supplied game files. HOPE is unofficial and is not endorsed by Electronic Arts." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,24"/>
          <TextBlock Text="HOPE" Foreground="{StaticResource Lime}" FontWeight="Black" FontSize="27"/>
          <TextBlock Text="Hills, Ollies, Pavement, Expression.&#10;A nod to street skating and Bay Area skate culture." TextWrapping="Wrap" Foreground="#C8BED9" Margin="0,8,0,0"/>
         </StackPanel>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>
     <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
      <TextBlock x:Name="InputHint" Text="Mouse to choose • Tab to move • Enter to select • Esc to go back" Foreground="{StaticResource Mint}" FontSize="12" Margin="0,0,0,7"/>
      <TextBlock x:Name="Feedback" Text="Built for your next session." Foreground="{StaticResource Mint}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="YOUR OWN SKATE 3 XBOX 360 ISO REQUIRED • NO GAME FILES OR DOWNLOAD LINKS PROVIDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Lime}"/>
      <TextBlock Text="Based on Skate3Recomp by mchughalex  /  ReXGlue + Xenia  /  Unofficial community update" Foreground="#C4B8D5" FontSize="11" Margin="0,6,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Viewbox>
 </Grid>
</Window>
