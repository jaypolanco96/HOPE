*.exe
*.map

# Editor and CMake scratch
/.vs/
/.vscode/
/.cache/

# Local developer scripts (texture decoding, extraction, bootstrap helpers)
/scripts/

# HOPE launcher build output and artwork extracted from the player's game.
/launcher/bin/
/launcher/obj/
/launcher/assets/gameplay/

# Local Python analysis bytecode.
__pycache__/
*.pyc
